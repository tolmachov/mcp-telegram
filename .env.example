# Documentation only: the binary never loads .env files.
# Export variables in the process environment or pass CLI flags explicitly.

MCP_TELEGRAM_API_ID=
MCP_TELEGRAM_API_HASH=
MCP_TELEGRAM_ALLOWED_PATHS=
MCP_TELEGRAM_MEDIA_MAX_BYTES=52428800
MCP_TELEGRAM_RATE_LIMIT_RPS=1
MCP_TELEGRAM_PINNED_REFRESH_SECONDS=30
MCP_TELEGRAM_FLOOD_WAIT_MAX_SECONDS=60

# Chat content is sent to the selected external provider unless sampling is used.
MCP_SUMMARIZE_PROVIDER=sampling
MCP_SUMMARIZE_MODEL=
MCP_SUMMARIZE_BATCH_TOKENS=8000
MCP_SUMMARIZE_OLLAMA_URL=http://localhost:11434
MCP_SUMMARIZE_GEMINI_API_KEY=
MCP_SUMMARIZE_ANTHROPIC_API_KEY=

MCP_TRANSPORT=stdio
MCP_HTTP_ADDR=127.0.0.1:8080
MCP_VARIANT=
MCP_LOG_FORMAT=
MCP_LOG_LEVEL=info

# HTTP always requires this complete OAuth configuration.
MCP_AUTH_ISSUER_URL=
MCP_AUTH_ALLOWED_USERS=
MCP_AUTH_TOKEN_KEYS=
MCP_AUTH_ALLOWED_REDIRECTS=
MCP_AUTH_TRUSTED_PROXY_HOPS=0
# Exactly one backend is required in HTTP mode.
MCP_AUTH_SESSION_BUCKET=
MCP_AUTH_SESSION_DIR=

TEST_CHAT_ID=
TEST_GROUP_ID=
TEST_MESSAGE_LINK=
TEST_MESSAGE_SEARCH_QUERY=
TEST_SEARCH_QUERY=
