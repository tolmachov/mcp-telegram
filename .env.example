# ===========================================
# Required: Telegram API Credentials
# Get yours at https://my.telegram.org/apps
# ===========================================
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# ===========================================
# Optional: Summarization Configuration
# ===========================================

# Provider for chat summarization
# Options: sampling (default), ollama, gemini, anthropic
# - sampling: Uses MCP client's LLM (recommended, no extra setup)
# - ollama: Local LLM via Ollama
# - gemini: Google Gemini API
# - anthropic: Anthropic Claude API
SUMMARIZE_PROVIDER=sampling

# Model name (provider-specific, leave empty for defaults)
# - ollama: llama3.2, mistral, etc.
# - gemini: gemini-2.0-flash (default)
# - anthropic: claude-haiku-4-5-20251001 (default)
SUMMARIZE_MODEL=

# Approximate tokens per batch for summarization (default: 8000)
SUMMARIZE_BATCH_TOKENS=8000

# ===========================================
# Provider-specific API keys
# ===========================================

# Ollama API URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Google Gemini API key (required if SUMMARIZE_PROVIDER=gemini)
GEMINI_API_KEY=

# Anthropic API key (required if SUMMARIZE_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ===========================================
# Optional: File Operations
# ===========================================

# Allowed directories for backup operations (comma-separated)
# Default: OS-specific application data directory
# Example: /home/user/backups,/tmp/telegram-backups
TELEGRAM_ALLOWED_PATHS=

# ===========================================
# Optional: Client tuning
# ===========================================

# Max bytes GetMedia will download in a single call (default: 52428800 = 50 MiB)
TELEGRAM_MEDIA_MAX_BYTES=

# Requests-per-second ceiling for history-fetching calls (0 = safe default).
# Raise with care: exceeding Telegram's thresholds trips FLOOD_WAIT for all tools.
TELEGRAM_RATE_LIMIT_RPS=

# Polling interval (seconds) for the pinned-chat resource watcher (default: 30;
# 0 disables the watcher).
TELEGRAM_PINNED_REFRESH_SECONDS=

# Max seconds to wait out a Telegram FLOOD_WAIT before failing fast with a
# retry-after hint (default: 60). Keep below your MCP client's tool-call timeout
# (Claude Desktop cancels around 240s).
TELEGRAM_FLOOD_WAIT_MAX_SECONDS=

# ===========================================
# Integration tests (only needed to run `make test-integration`)
# These point the live-account integration suite at real chats you own; the
# suite skips any test whose variable is unset.
# ===========================================

# A one-on-one dialog chat ID.
TEST_CHAT_ID=
# A group/supergroup chat ID.
TEST_GROUP_ID=
# A t.me message link used by the link-resolution test.
TEST_MESSAGE_LINK=
# A query expected to match messages in TEST_CHAT_ID (in-chat search test).
TEST_MESSAGE_SEARCH_QUERY=
# A query for the cross-chat global message search test.
TEST_SEARCH_QUERY=
