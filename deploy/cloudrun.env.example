# Non-secret Cloud Run environment. Secrets come from Secret Manager.
MCP_TRANSPORT: http

MCP_AUTH_ISSUER_URL: https://mcp-telegram-XXXXXXXX-ew.a.run.app
MCP_AUTH_ALLOWED_USERS: "123456789"
MCP_AUTH_SESSION_BUCKET: my-mcp-telegram-sessions
# Keep zero unless the complete deployed proxy chain has been verified.
MCP_AUTH_TRUSTED_PROXY_HOPS: "0"

MCP_TELEGRAM_API_ID: "12345678"
MCP_SUMMARIZE_PROVIDER: sampling
