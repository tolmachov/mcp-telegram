# Non-secret environment for the Cloud Run service (pass via --env-vars-file
# or repeated --set-env-vars). Secrets — TELEGRAM_API_HASH and AUTH_TOKEN_KEY —
# must come from Secret Manager via --set-secrets instead.

# Streamable HTTP transport on the Cloud Run port.
MCP_TRANSPORT: http
MCP_HTTP_ADDR: ":8080"

# Embedded OAuth 2.1 + per-user Telegram QR login.
MCP_AUTH: telegram

# Public URL of the service (the OAuth issuer). Fill in after the first
# deploy, then redeploy — tokens are bound to this value.
AUTH_ISSUER_URL: https://mcp-telegram-XXXXXXXX-ew.a.run.app

# Comma-separated numeric Telegram user ids allowed to log in.
AUTH_ALLOWED_USERS: "123456789"

# GCS bucket holding encrypted per-user Telegram sessions.
AUTH_SESSION_BUCKET: my-mcp-telegram-sessions

# Telegram API credentials (https://my.telegram.org). The hash is a secret —
# set only the id here.
TELEGRAM_API_ID: "12345678"
